__pycache__/
*.py[cod]
*.egg-info/
.eggs/

.pixi/
.venv/
venv/

# JAAD and PIE reference repos are cloned by scripts/fetch_external.sh.
# Keeping them out of git: 600MB+, and they carry their own history.
/external/

# Leading slashes matter here. A bare "data/" matches a directory called data
# at ANY depth, which silently swallowed the whole src/pif/data package.
# Anchored to the repo root, these only hide the caches they were meant to.
/data/
/checkpoints/
/runs/
/artifacts/
/build/
/dist/

*.pt
*.pth
*.onnx
*.ckpt

.ipynb_checkpoints/
.pytest_cache/
.DS_Store
*.swp
